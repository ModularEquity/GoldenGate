# Database (SQLite file for local dev)
DATABASE_URL="file:./dev.db"

# JWT session signing — required in production (min 32 chars)
# openssl rand -base64 32
AUTH_SECRET=""

# Public site URL for magic links (set on Vercel)
APP_URL="http://localhost:3000"

# Email (Resend) — without this, magic links are logged to the server console only
RESEND_API_KEY=""
# Must be a verified domain sender in production; resend.dev only works for account email
EMAIL_FROM="GoldenGate <onboarding@resend.dev>"
