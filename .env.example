# Database (SQLite file for local dev)
DATABASE_URL="file:./dev.db"

# JWT session signing — required in production (min 32 chars)
# openssl rand -base64 32
AUTH_SECRET=""

# Public site URL for magic links (no trailing slash). Local dev:
APP_URL="http://localhost:3000"
# Production (Vercel stable domain): https://golden-gate-seven.vercel.app
# Or your custom domain once added in Vercel — not the per-deployment *.vercel.app URL

# Email (Resend) — without RESEND_API_KEY, magic links are logged to the server console only
RESEND_API_KEY=""
# Verified domain modularequity.com — use an address on that domain in production, e.g.:
# EMAIL_FROM="GoldenGate <noreply@modularequity.com>"
EMAIL_FROM="GoldenGate <onboarding@resend.dev>"
