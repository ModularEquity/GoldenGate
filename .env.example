# Database (SQLite file for local dev)
DATABASE_URL="file:./dev.db"

# JWT session signing — required in production (min 32 chars)
# openssl rand -base64 32
AUTH_SECRET=""

# Public site URL for magic links (set on Vercel)
APP_URL="http://localhost:3000"

# Email (Resend) — without RESEND_API_KEY, magic links are logged to the server console only
RESEND_API_KEY=""
# onboarding@resend.dev only sends to your Resend login email. For real users: verify domain in Resend, then e.g. GoldenGate <noreply@yourdomain.com>
EMAIL_FROM="GoldenGate <onboarding@resend.dev>"
