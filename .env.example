# PostgreSQL — local: docker compose up -d, then use the same URL for both (no pooler locally):
DATABASE_URL="postgresql://goldengate:goldengate@localhost:5432/goldengate"
POSTGRES_URL_NON_POOLING="postgresql://goldengate:goldengate@localhost:5432/goldengate"
# Vercel + Neon: integration sets DATABASE_URL + POSTGRES_URL_NON_POOLING automatically

# JWT session signing — required in production (min 32 chars)
# openssl rand -base64 32
AUTH_SECRET=""

# Email (Resend) — only secret you need for sending in production
RESEND_API_KEY=""
# Optional overrides (defaults are fine on Vercel — see README):
# APP_URL="https://your-custom-domain.com"
# EMAIL_FROM="GoldenGate <noreply@modularequity.com>"
