# PostgreSQL — names must match prisma/schema.prisma (Vercel Neon uses project prefix).
# Local: docker compose up -d, then same URL twice:
goldengate_DATABASE_URL="postgresql://goldengate:goldengate@localhost:5432/goldengate"
goldengate_POSTGRES_URL_NON_POOLING="postgresql://goldengate:goldengate@localhost:5432/goldengate"
# Vercel: Neon integration injects goldengate_DATABASE_URL, goldengate_POSTGRES_URL_NON_POOLING, etc.

# NextAuth / Auth.js — required in production
# Random signing key for sessions (NOT the Google client secret). Generate: npm run auth:secret
AUTH_SECRET=""
# Public site URL (fixes Google OAuth on custom domain — use with modularequity.com)
# AUTH_URL=https://modularequity.com
# APP_URL=https://modularequity.com
# NEXT_PUBLIC_APP_URL=https://modularequity.com
# (Share links on /dashboard/profile use NEXT_PUBLIC_APP_URL for the register?ref= URL)
# Optional: Redfin link for Umberland deal card
# NEXT_PUBLIC_UMBERLAND_REDFIN_URL=https://www.redfin.com/...
# Google OAuth (register + login) — separate from AUTH_SECRET
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (planned — payments & Financial Connections). See /dashboard/roadmap
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Plaid (optional legacy bank link — Fund page). Not used for KYC going forward.
PLAID_CLIENT_ID=""
# Use PLAID_SECRET or PLAID_API_SECRET (Vercel often uses the latter)
PLAID_SECRET=""
# PLAID_API_SECRET=""
# PLAID_ENV=sandbox

# Email (Resend) — only secret you need for sending in production
RESEND_API_KEY=""
# Optional overrides (defaults are fine on Vercel — see README):
# APP_URL="https://your-custom-domain.com"
# EMAIL_FROM="GoldenGate <noreply@modularequity.com>"
