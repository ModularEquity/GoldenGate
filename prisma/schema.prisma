// PostgreSQL everywhere (local + Vercel). See docs/database-vercel-postgres.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL (Neon: recommended / pooler). Vercel + Neon integration sets this.
  url       = env("DATABASE_URL")
  // Non-pooling URL for `prisma migrate`. Vercel + Neon injects `POSTGRES_URL_NON_POOLING` — no manual DIRECT_URL.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  magicLinkTokens MagicLinkToken[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
