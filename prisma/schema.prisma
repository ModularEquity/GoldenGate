// PostgreSQL everywhere (local + Vercel). See docs/database-vercel-postgres.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel Neon integration prefixes vars with the project name, e.g. `goldengate_DATABASE_URL`.
  url       = env("goldengate_DATABASE_URL")
  directUrl = env("goldengate_POSTGRES_URL_NON_POOLING")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  magicLinkTokens MagicLinkToken[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
