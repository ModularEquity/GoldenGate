// PostgreSQL everywhere (local + Vercel). See docs/database-vercel-postgres.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("goldengate_DATABASE_URL")
  directUrl = env("goldengate_POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  INVESTOR
  EMPLOYEE
}

enum MagicLinkPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  role            UserRole         @default(INVESTOR)
  passwordHash    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  magicLinkTokens MagicLinkToken[]
  wallets         Wallet[]
  plaidAccounts   PlaidAccount[]
  fundingIntents  FundingIntent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  chain     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PlaidAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  accessToken     String
  institutionName String?
  accountId       String
  mask            String?
  name            String?
  subtype         String?
  createdAt       DateTime @default(now())

  fundingIntents FundingIntent[]

  @@index([userId])
}

enum FundingStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model FundingIntent {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String         @default("USD")
  plaidAccountId String?
  plaidAccount   PlaidAccount?  @relation(fields: [plaidAccountId], references: [id], onDelete: SetNull)
  status         FundingStatus  @default(PENDING)
  note           String?
  createdAt      DateTime       @default(now())

  @@index([userId])
}

model MagicLinkToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   MagicLinkPurpose @default(SET_PASSWORD)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}
