// PostgreSQL everywhere (local + Vercel). See docs/database-vercel-postgres.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("goldengate_DATABASE_URL")
  directUrl = env("goldengate_POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  INVESTOR
  EMPLOYEE
}

enum MagicLinkPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  role            UserRole         @default(INVESTOR)
  passwordHash    String?
  bankLinkedAt    DateTime?
  /** Investor questionnaire / entity profile (onboarding step 1) */
  investorProfileCompletedAt DateTime?
  /** PPM & risk disclosures acknowledged */
  ppmRiskCompletedAt         DateTime?
  /** W-9 / W-8 tax path submitted */
  taxCompletedAt             DateTime?
  /** Saved tax intake (W-9 / W-8BEN / W-8BEN-E style fields) for PDF generation */
  taxProfileJson             Json?
  /** Mercury wire instructions read (optional without bank link) */
  wireInstructionsAcknowledgedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  magicLinkTokens MagicLinkToken[]
  wallets         Wallet[]
  plaidAccounts   PlaidAccount[]
  manualBankAccounts ManualBankAccount[]
  fundingIntents  FundingIntent[]
  dealSubscriptions DealSubscription[]
  /** Unique share/referral code for invite links (investors) */
  referralCode    String?  @unique
  /** Referral code used at signup (?ref=), if any */
  referredByCode  String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  chain     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/** User-entered bank reference (last-4 only); use Plaid for verified ACH */
model ManualBankAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname        String?
  institutionName String
  accountType     String   @default("checking")
  routingLast4    String
  accountLast4    String
  createdAt       DateTime @default(now())
  fundingIntents  FundingIntent[]

  @@index([userId])
}

model PlaidAccount {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId              String
  accessToken         String
  institutionName     String?
  accountId           String
  mask                String?
  name                String?
  subtype             String?
  /** LINKED | OWNERSHIP_VERIFIED — set after Auth numbers match */
  verificationStatus String   @default("LINKED")
  createdAt           DateTime @default(now())

  fundingIntents FundingIntent[]

  @@index([userId])
}

enum FundingStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model FundingIntent {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String         @default("USD")
  plaidAccountId String?
  plaidAccount   PlaidAccount?  @relation(fields: [plaidAccountId], references: [id], onDelete: SetNull)
  manualBankAccountId String?
  manualBankAccount   ManualBankAccount? @relation(fields: [manualBankAccountId], references: [id], onDelete: SetNull)
  status         FundingStatus  @default(PENDING)
  note           String?
  createdAt      DateTime       @default(now())

  @@index([userId])
}

enum DealStatus {
  OPEN
  CLOSING
  CLOSED
}

model Deal {
  id                  String     @id @default(cuid())
  slug                String     @unique
  name                String
  status              DealStatus @default(OPEN)
  city                String
  state               String
  summary             String     @db.Text
  highlights          Json?
  /** Listing URL (Redfin, etc.) — OG image fetched for thumbnail */
  propertyUrl         String
  thumbnailUrl        String?
  purchaseUsd         Int
  saleUsd             Int
  holdPeriodMonths    Int
  /** Debt financing rate e.g. 10% */
  debtRatePct         Decimal    @db.Decimal(5, 2)
  renoBudgetUsd       Int
  transactionFeesUsd  Int
  totalCostUsd        Int
  profitUsd           Int
  moneyToCloseUsd     Int
  closeDate           DateTime?  @db.Date
  moneyToRenoUsd      Int
  /** Loan-to-value vs total project cost (e.g. 80 = 80% debt, 20% equity) */
  ltvPct              Int        @default(80)
  renovationCompleteDate DateTime? @db.Date
  listingDate         DateTime?  @db.Date
  saleTargetDate      DateTime?  @db.Date
  /** Max subscription as % of total cost (e.g. 20 = 20% of total cost) */
  maxSubscriptionPctOfTotalCost Int @default(20)
  /** GP / sponsor equity participation (dollars) — shown on deal for clarity */
  gpContributionUsd   Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  subscriptions DealSubscription[]

  @@index([status])
  @@index([slug])
}

/** Investor subscription intent for a deal (amount in USD cents) */
model DealSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dealId])
  @@index([dealId])
}

model MagicLinkToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   MagicLinkPurpose @default(SET_PASSWORD)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}
